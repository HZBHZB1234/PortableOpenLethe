<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ValList<T>.list is set only by JsonSerializer (IncludeFields) reflection. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <!--
    Portable build: static data is NEVER embedded. The JSON trees live in the
    top-level `static/` directory and are read at runtime by StaticData.cs via
    STATIC_DATA_DIR. Publishing copies that directory next to the executable;
    the Hub may replace it with synced official data.
  -->

</Project>
