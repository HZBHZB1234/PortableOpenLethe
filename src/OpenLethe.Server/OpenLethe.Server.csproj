<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\OpenLethe.Packets\OpenLethe.Packets.csproj" />
    <ProjectReference Include="..\OpenLethe.Data\OpenLethe.Data.csproj" />
    <ProjectReference Include="..\OpenLethe.Resources\OpenLethe.Resources.csproj" />
    <ProjectReference Include="..\OpenLethe.PluginHost\OpenLethe.PluginHost.csproj" />
    <ProjectReference Include="..\OpenLethe.Scripting\OpenLethe.Scripting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.18">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Running the published DLL directly needs wwwroot beside it, not just in the project. -->
  <Target Name="CopyWwwRootToOutput" AfterTargets="Build">
    <ItemGroup>
      <_WwwRootFiles Include="$(MSBuildThisFileDirectory)wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WwwRootFiles)"
          DestinationFiles="@(_WwwRootFiles->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Static data is never embedded: place the whole tree beside the published exe. -->
  <Target Name="CopyStaticDataOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <_StaticDataFiles Include="$(MSBuildThisFileDirectory)..\..\static\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_StaticDataFiles)"
          DestinationFiles="@(_StaticDataFiles->'$(PublishDir)static\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
